# Dependencies
node_modules/
**/node_modules/

# Build outputs
backend/dist/
frontend/.next/

# Database (runtime SQLite stores). Ignore the WHOLE directory so the live DB
# and its WAL/SHM sidecar files (e.g. dashboard.db-wal, dashboard.db-shm) are
# never tracked or shown as modified by git. Note: .gitignore does NOT untrack
# files that were committed earlier — those must be removed with:
#   git rm --cached <path>
backend/database/
data/

# Environment files (contain secrets)
.env
.env.*
!.env.example
!.env.docker.example
backend/.env
backend/.env.*
backend/!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Plans (internal)
plans/
