# SelfHost Dashboard - Docker Environment Variables
# Copy this file to .env.docker and edit the values

# Timezone
TZ=Europe/Madrid

# Encryption key for stored SSH passwords
# Generate with: openssl rand -hex 32
SSH_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# Prometheus URL for energy monitoring (leave empty to disable)
PROMETHEUS_URL=http://your-prometheus-host:port 

# SSH key authentication (uncomment and set if using key-based auth)
SSH_PRIVATE_KEY_PATH=/app/ssh_key

SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
