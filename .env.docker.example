# SelfHost Dashboard - Docker Environment Variables
# Copy this file to .env.docker and edit the values

# Timezone
TZ=Europe/Madrid

# ─────────────────────────────────────────────────────────────────────────────
# Login / Authentication (OPTIONAL)
# Set BOTH AUTH_USERNAME and AUTH_PASSWORD_HASH to enable the login page.
# If either is left empty, the dashboard is publicly accessible.
#
# Generate a password hash with bcrypt (Node.js), e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# or with the htpasswd tool:
#   htpasswd -nbB -C 10 "" 'your-password' | cut -d: -f2
#
# IMPORTANT: bcrypt hashes contain '$' characters, which Docker Compose tries
# to interpolate as variables. ALWAYS wrap the hash in single quotes to keep it
# literal, e.g. AUTH_PASSWORD_HASH='$2y$10$....'. Without the quotes Compose
# silently corrupts the hash (you'll see "variable is not set" warnings).
# ─────────────────────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Encryption key for stored SSH passwords
# Generate with: openssl rand -hex 32
SSH_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# Prometheus URL for energy monitoring (leave empty to disable)
PROMETHEUS_URL=http://your-prometheus-host:port 

# SSH key authentication (uncomment and set if using key-based auth)
SSH_PRIVATE_KEY_PATH=/app/ssh_key

SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
